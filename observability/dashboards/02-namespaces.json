        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory used vs limit (top 10)",
      "description": "Near 100 % means the next spike gets the container OOM-killed.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 6,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          },
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, max by (pod, container) (container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\"} / on(namespace,pod,container) kube_pod_container_resource_limits{namespace=\"$namespace\",resource=\"memory\"}))",
          "legendFormat": "{{pod}} / {{container}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
